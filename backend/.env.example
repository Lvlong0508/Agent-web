# MongoDB 连接配置
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agentweb
# MongoDB 集合名映射（JSON，可覆盖；key 为逻辑名，value 为真实集合名）
# MONGODB_COLLECTIONS={"agent_runs":"agent_runs","conversations":"conversations","messages":"messages"}

# MySQL 连接配置（应用账号仅授权 agent-web 库）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agentweb
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB_NAME=agent-web
# MySQL 表名映射（JSON，可覆盖；key 为逻辑名，value 为真实表名）
# MYSQL_TABLES={"expense":"expenses"}

# LLM 配置（Ollama 本地部署，默认地址）
OLLAMA_BASE_URL=http://localhost:11434

# DashScope 通义千问 API Key（阿里云百炼控制台获取，可选；不配置则前端不能用通义千问）
DASHSCOPE_API_KEY=

# Chroma 向量库连接配置（可选，默认 localhost:8000）
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# tenant 保持默认 default_tenant；database 用项目名与其他项目隔离（集合名无需加前缀）
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=agent-web
# Chroma 集合名映射（JSON，可覆盖；key 为 kb_type，value 为真实集合名）
# CHROMA_COLLECTIONS={"enterprise":"kb_enterprise","user":"kb_user","tool":"kb_tools","skill":"kb_skills"}