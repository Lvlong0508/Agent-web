# ===== 应用级配置（settings.py）=====
BACKEND_HOST=localhost
BACKEND_PORT=8088

# ===== 数据库配置（database_settings.py）=====

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agentweb
# MongoDB 集合名映射（JSON，可覆盖；key 为逻辑名，value 为真实集合名）
# MONGODB_COLLECTIONS={"agent_runs":"agent_runs","conversations":"conversations","messages":"messages"}

# MySQL（应用账号仅授权 agent-web 库）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agentweb
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB_NAME=agent-web
# MySQL 表名映射（JSON，可覆盖；key 为逻辑名，value 为真实表名）
# MYSQL_TABLES={"expense":"expenses"}

# Chroma 向量库（可选，默认 localhost:8000）
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# tenant 保持默认 default_tenant；database 用项目名与其他项目隔离（集合名无需加前缀）
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=agent-web
# Chroma 集合名映射（JSON，可覆盖；key 为 kb_type，value 为真实集合名）
# CHROMA_COLLECTIONS={"enterprise":"kb_enterprise","user":"kb_user","tool":"kb_tools","skill":"kb_skills"}

# ===== 大模型配置（agent_settings.py）=====

# Ollama 本地模型（默认地址）
OLLAMA_BASE_URL=http://localhost:11434

# DashScope 通义千问：API Key 从系统环境变量读取（不写本项目 .env，避免敏感信息入库），
# 未设置则前端不能用通义千问；端点可用 DASHSCOPE_BASE_URL 覆盖
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 向量模型（embedding）：走 DashScope 通道，EMBEDDING_DIM 改动需同步重建 Chroma 集合
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024