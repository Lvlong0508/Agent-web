# MongoDB 连接配置
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agentweb

# MySQL 连接配置（应用账号仅授权 agent-web 库）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agentweb
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB_NAME=agent-web

# LLM 配置（Ollama 本地部署，默认地址）
OLLAMA_BASE_URL=http://localhost:11434

# DashScope 通义千问 API Key（阿里云百炼控制台获取，可选；不配置则前端不能用通义千问）
DASHSCOPE_API_KEY=
